# OpenAI API Key (for AI-powered prompt generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Clerk Authentication
# Get these from https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Database
# Get these from https://supabase.com/dashboard/project/_/settings/api
# As of 2025, Supabase uses new API keys:
# - Use "Publishable key" (sb_publishable_...) for NEXT_PUBLIC_SUPABASE_ANON_KEY
# - Use "Secret key" (sb_secret_...) for SUPABASE_SERVICE_ROLE_KEY (server-only!)
# - Legacy "anon" key (eyJhbGci...) still works but will be deprecated in late 2026
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key-here

# Clerk Webhook Secret (REQUIRED for syncing users to Supabase)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
